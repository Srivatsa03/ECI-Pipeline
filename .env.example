# Groq API Key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Supabase PostgreSQL connection string
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Set to "true" to use Supabase, "false" to use local SQLite
USE_SUPABASE=true
