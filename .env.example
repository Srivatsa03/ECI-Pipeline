# ── LLM ───────────────────────────────────────────────────────────
# Groq API Key — get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Database ──────────────────────────────────────────────────────
# Leave USE_SUPABASE unset (or DATABASE_URL empty) to run on local SQLite at
# data/eci.db. No Postgres required for development or the console demo.
USE_SUPABASE=false

# Local Postgres + pgvector via docker compose:
# DATABASE_URL=postgresql+psycopg2://eci:eci@localhost:5432/eci
#
# Hosted Supabase:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# ── API service (api/main.py) ─────────────────────────────────────
# Comma-separated origins allowed to call the API.
ECI_CORS_ORIGINS=http://localhost:3000,http://localhost:4123

# ── Console (dashboard/.env.local) ────────────────────────────────
# ECI_DATA_SOURCE=offline   # default: in-process dataset, zero infrastructure
# ECI_DATA_SOURCE=api       # read the FastAPI service instead
# ECI_API_URL=http://localhost:8000
